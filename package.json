{
  "name": "voiceframe",
  "version": "0.1.0",
  "private": true,
  "description": "Voice Web Application Framework — turns a static HTML page into a voice-controlled app under agent supervision.",
  "type": "module",
  "scripts": {
    "serve": "npx serve .",
    "e2e:auth:save": "node scripts/save-voice-notes-auth-state.mjs",
    "e2e:auth:upload-secret": "node scripts/upload-voice-notes-auth-secret.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "google-auth-library": "^10.4.1"
  }
}
